# Server Configuration
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database Mode: 'mock' (default for testing without MySQL) or 'mysql'
DB_DRIVER=mock

# MySQL Database Configuration (Required when DB_DRIVER=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=tc_management_db
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_CONNECTION_LIMIT=10
